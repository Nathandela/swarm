# Go
/bin/
*.exe
*.test
*.out
/dist/

# macOS
.DS_Store

# Editor
.idea/
.vscode/

# Agent worktrees. `git worktree add` under .claude/ leaves a full checkout per agent, and
# repo-wide gates that walk from the root scan them: TestB30_NoCallerOutsideTheCoreAdopts
# TheWholeDurableBlob fails on `core.Save` inside an agent's copy of mobile/app.go, which is
# not a caller in this repository at all. Eighteen of them accumulated during one session.
.claude/worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# build artifacts
/swarm

# Android (S13)
android/.gradle/
android/build/
android/app/build/
# PB-TOOL-2: the AAR and its sources jar are build outputs of android/build-aar.sh.
android/app/libs/
*.aar
# Kotlin 2.x writes build-session state here. It is a build output, it is not under any
# directory already ignored above, and this repository has five recorded incidents of a
# `git add -A` committing an artifact -- one of them a derivation mutation that reached a demo
# binary (ADR-007 B132 F1, residuals 4.7). Ignoring it is cheaper than the sixth.
android/.kotlin/

# PB-TOOL-3: release signing material is operator-supplied and never enters the repository.
# local.properties additionally carries the machine's SDK path.
*.jks
*.keystore
*.p12
*.pfx
*.bks
local.properties
