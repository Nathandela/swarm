<?xml version="1.0" encoding="utf-8"?>
<!--
  Atmospheric Swarm launcher foreground.

  The artwork is the approved transparent mark from
  docs/design/swarm-illustration-direction/swarm-atmospheric-mark.png, copied byte-for-byte to
  drawable-nodpi/swarm_atmospheric_mark.png. Keeping the generated trails as a bitmap preserves
  their fine glow, grain, and soft edges; restating them as vector paths would create a second,
  harsher drawing.

  The adaptive canvas is 108dp. A 24dp inset leaves a 60dp square. Measured from every non-zero
  alpha pixel in the approved source, the furthest visible point then lands within Android's
  guaranteed 33dp mask-safe radius. android/gate/appicon_test.go verifies the source identity,
  alpha geometry, inset, and adaptive-layer wiring.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="24dp">
    <bitmap
        android:src="@drawable/swarm_atmospheric_mark"
        android:gravity="fill" />
</inset>
