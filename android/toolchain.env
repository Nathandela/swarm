# PB-TOOL-1 -- the Android toolchain, pinned in-repo.
#
# POSIX sh, meant to be SOURCED, not executed:
#
#     . android/toolchain.env
#
# It exists because nothing Android is discoverable on this host by default: no ANDROID_*
# variable is exported, nothing Android is on PATH, /usr/libexec/java_home reports no JVM, and
# the Homebrew JDK and the command-line SDK both sit in non-standard locations. A fresh shell
# that has not sourced this file concludes there is no Android toolchain at all, which is
# wrong and has already cost three readers.
#
# VERSIONS are pinned. LOCATIONS are discovered, because they differ between this laptop and a
# CI runner and a path is not a decision. Discovery is driven by the pinned version wherever
# the layout allows it, and an exported variable always wins -- so a runner that already
# exports JAVA_HOME or ANDROID_HOME keeps it.

# --- Pinned versions --------------------------------------------------------

# The pinned JDK feature release. AGP requires 17 as a MINIMUM and this was 17 until
# 2026-08-02, when the targetSdk/compileSdk bump to 36 forced it to 21.
#
# THE BINDING CONSTRAINT IS ROBOLECTRIC, NOT AGP. Robolectric picks its sandbox SDK from
# compileSdk, and its compatibility table (robolectric.org/compatibility_table) pairs Android
# 16 / API 36 with Java 21 where API 35 needed only 17. On 17 every Robolectric test in this
# module fails at class-init with "Failed to create a Robolectric sandbox: Android SDK 36
# requires Java 21 (have Java 17)" -- 43 of them, before a single assertion runs. robolectric
# 4.16.1 itself is fine; it covers API 23..36.
#
# The alternative was a second pin naming a Java 21 toolchain for the test tasks only, keeping
# AGP on 17. Rejected: it is permanent structure (a second pin, plus a gate whose only job is
# to stop the two drifting) bought to avoid a one-time verification, and a split-JDK build is a
# thing every future contributor has to learn. One pin cannot drift from itself.
#
# THE EMITTED BYTECODE IS UNCHANGED. compileOptions and the Kotlin jvmTarget in
# android/app/build.gradle.kts stay at 17; this moves only the JVM that Gradle, AGP and the
# test tasks RUN on.
SWARM_JDK_MAJOR=21

# The Go release line the AAR cross-compiles with. This is the module floor (go.mod's `go`
# directive, ADR-008), not a ceiling: a newer local toolchain satisfies it.
SWARM_GO_VERSION=1.25

# PB-RUN-1. The three are separate decisions and are recorded separately;
# android/supported-versions.tsv is the matrix whose endpoints these are.
SWARM_ANDROID_COMPILE_SDK=36
SWARM_ANDROID_MIN_SDK=33
SWARM_ANDROID_TARGET_SDK=36

SWARM_ANDROID_BUILD_TOOLS=36.0.0
SWARM_ANDROID_NDK=27.2.12479018

# gomobile's -androidapi: the NDK's floor, a DIFFERENT number from minSdk. gomobile defaults
# to API 16 and NDK 27 refuses it; NDK 27 supports 21..35. The app's supported floor is above
# this and is pinned independently, so a later edit to one cannot silently move the other.
SWARM_ANDROID_API=21

# PB-TOOL-1: must equal go.mod's golang.org/x/mobile require.
SWARM_GOMOBILE_VERSION=v0.0.0-20260709172247-6129f5bee9d5

# PB-TOOL-4. The distribution checksum pins the bytes the wrapper downloads; the jar checksum
# pins the committed bootstrap jar, which executes on every build, is not human-readable, and
# is routinely regenerated by IDEs.
#
# 9.5.1 rather than the 9.6.1 this host has installed: Gradle 9.6.0 removed the internal API
# `org.gradle.api.problems.internal.InternalProblems`, and AGP 8.x fails to apply on it. AGP
# 9 is the version that no longer uses it, and AGP 9 in turn REJECTS the
# `org.jetbrains.kotlin.android` plugin -- which PB-TOOL-6's gate requires. The pin therefore
# names a version the host does not have, which is what a wrapper is for, and makes
# TestPBTOOL4_GradlewRunsWithoutSystemGradle a real assertion rather than a coincidence.
SWARM_GRADLE_VERSION=9.5.1
SWARM_GRADLE_DISTRIBUTION_SHA256=bafc141b619ad6350fd975fc903156dd5c151998cc8b058e8c1044ab5f7b031f
SWARM_GRADLE_WRAPPER_JAR_SHA256=497c8c2a7e5031f6aa847f88104aa80a93532ec32ee17bdb8d1d2f67a194a9c7

# PB-TOOL-2: the explicit ABI set, not a glob. arm64-v8a is every current handset and the
# local swarmtest AVD; x86_64 is what a GitHub runner's emulator needs. The gate asserts the
# artifact carries exactly this set, so "explicit" cannot decay into "at least these".
SWARM_AAR_ABIS="arm64-v8a x86_64"

export SWARM_JDK_MAJOR SWARM_GO_VERSION
export SWARM_ANDROID_COMPILE_SDK SWARM_ANDROID_MIN_SDK SWARM_ANDROID_TARGET_SDK
export SWARM_ANDROID_BUILD_TOOLS SWARM_ANDROID_NDK SWARM_ANDROID_API
export SWARM_GOMOBILE_VERSION
export SWARM_GRADLE_VERSION SWARM_GRADLE_DISTRIBUTION_SHA256 SWARM_GRADLE_WRAPPER_JAR_SHA256
export SWARM_AAR_ABIS

# --- Locations --------------------------------------------------------------

# The JDK is Homebrew-installed here and is NOT registered with /usr/libexec/java_home. The
# remaining candidates are a GitHub runner's actions/setup-java tool cache and a distro
# package; the first entry is also the fallback, so the variable is never empty and a missing
# toolchain fails as "this path does not exist" rather than as an unset variable.
if [ ! -d "${JAVA_HOME:-}" ]; then
    JAVA_HOME=/usr/local/opt/openjdk@$SWARM_JDK_MAJOR
    for swarm_pin_candidate in \
        /usr/local/opt/openjdk@$SWARM_JDK_MAJOR \
        /opt/homebrew/opt/openjdk@$SWARM_JDK_MAJOR \
        /opt/hostedtoolcache/Java_Temurin-Hotspot_jdk/$SWARM_JDK_MAJOR.*/x64 \
        /usr/lib/jvm/temurin-$SWARM_JDK_MAJOR-jdk-amd64
    do
        if [ -x "$swarm_pin_candidate/bin/javac" ]; then
            JAVA_HOME=$swarm_pin_candidate
            break
        fi
    done
fi

# The SDK is a command-line-tools install, not the Android Studio default.
if [ ! -d "${ANDROID_HOME:-}" ]; then
    ANDROID_HOME=/usr/local/share/android-commandlinetools
    for swarm_pin_candidate in \
        /usr/local/share/android-commandlinetools \
        /usr/local/lib/android/sdk \
        "$HOME/Library/Android/sdk" \
        "$HOME/Android/Sdk"
    do
        if [ -d "$swarm_pin_candidate/platforms" ]; then
            ANDROID_HOME=$swarm_pin_candidate
            break
        fi
    done
fi

# gomobile and AGP read different variables for the same directory.
ANDROID_SDK_ROOT=$ANDROID_HOME

# gomobile bind needs the NDK explicitly; there is no default. Derived rather than defaulted:
# a runner that exports ANDROID_NDK_HOME points at its own preinstalled NDK, which would
# quietly build against a version this file did not pin.
ANDROID_NDK_HOME=$ANDROID_HOME/ndk/$SWARM_ANDROID_NDK

export JAVA_HOME ANDROID_HOME ANDROID_SDK_ROOT ANDROID_NDK_HOME

# The Go toolchain. Homebrew puts the real GOROOT under Cellar and only symlinks the launcher
# into /usr/local/bin, which this pin deliberately does not add to PATH: that directory also
# holds a system Gradle that would mask the checked-in wrapper.
swarm_pin_goroot=
if ! command -v go >/dev/null 2>&1; then
    for swarm_pin_candidate in \
        /usr/local/go \
        /usr/local/opt/go/libexec \
        /opt/homebrew/opt/go/libexec \
        /opt/hostedtoolcache/go/$SWARM_GO_VERSION.*/x64
    do
        if [ -x "$swarm_pin_candidate/bin/go" ]; then
            swarm_pin_goroot=$swarm_pin_candidate
            break
        fi
    done
fi

# --- PATH -------------------------------------------------------------------
#
# `gomobile bind` spawns gobind as a CHILD process. When gobind exists but is not on the
# child's PATH it reports "gobind was not found. Please run gomobile init", which names the
# wrong cause; S8 lost time to it. ${GOPATH:-$HOME/go}/bin below is the fix.
PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin:${GOPATH:-$HOME/go}/bin:$PATH"
if [ -n "$swarm_pin_goroot" ]; then
    PATH="$swarm_pin_goroot/bin:$PATH"
fi
export PATH

unset swarm_pin_goroot swarm_pin_candidate
