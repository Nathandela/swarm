[Unit]
Description=Swarm public push gateway
Documentation=https://github.com/Nathandela/swarm/blob/main/docs/operations/push-gateway-deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swarm-pushgw
Group=swarm-pushgw
# The attached VM service account is discovered through ADC and must belong to
# swarm-8404f. One token source carries both FCM and Play Integrity scopes.
ExecStart=/opt/swarm-pushgw/bin/swarm-pushgw -db /var/lib/swarm-pushgw/pushgw.db -listen 127.0.0.1:8450 -admin-listen 127.0.0.1:8451 -insecure-http -trusted-proxies 127.0.0.1/32 -gcp-project-id swarm-8404f -gcp-project-number 733314021126 -android-package dev.swarm.phone -play-signing-cert-sha256 hz8YTGhTTgpYccjMiQDrhx5HcddqRsTu1HRcmhhknmU
Restart=on-failure
RestartSec=5s
StateDirectory=swarm-pushgw
WorkingDirectory=/var/lib/swarm-pushgw

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/swarm-pushgw
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
