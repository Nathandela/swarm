<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  swarm nightly auto-upgrade timer (docs/specifications/auto-upgrade-plan.md, L1). Runs a
  brew cask upgrade for swarm, then converges the running gateway and daemon onto whatever
  is now linked, every night at 04:00: a preference, not a guarantee, since launchd runs a
  missed StartCalendarInterval job at the next wake, so on a laptop closed overnight this
  runs at lid-open instead. The two steps in ProgramArguments below are joined by ";", not
  "&&": the converge must run whether or not brew found anything to upgrade, or a deferred
  night is never retried (see the plan's "why the timer and not the cask postflight").

  This is a TEMPLATE, tracked here (packaging/, sibling of dist/, which is goreleaser's
  gitignored output; packaging/homebrew/swarm.rb is the same kind of tracked artifact).
  It carries exactly two tokens, @PREFIX@ (the Homebrew prefix) and @HOME@, filled in at
  install time. The install command, the precondition and what the log's exit codes mean
  are in docs/ops/auto-upgrade.md; they are not repeated here because XML forbids two
  hyphens in a row inside a comment, and every command involved spells a flag that way.

  INSTALL THIS ONLY ONCE `swarm version` REPORTS 0.13.2 OR LATER (the plan's section 3,
  "the hop"): a 0.13.0 or 0.13.1 `swarm daemon restart` ignores every argument, including the
  unattended flag named in ProgramArguments below, and runs the full stop-and-spawn from
  whatever environment this timer's gui agent carries, which is not the owner's shell.

  The platform /usr/bin/perl validates and truncates one owned log descriptor before
  execing the shell with both streams inherited. Each run keeps only its own diagnostics;
  one run may still grow without a size ceiling. Reinstall the unit to adopt this template.
  Requires the macOS system Perl (no external Perl modules).

  A launchd user agent carries HOME, USER, SHELL and TMPDIR but not the owner's PATH or
  credentials, hence @PREFIX@ rather than a bare `brew`/`swarm` on PATH; the daemon
  restart's own unattended environment handling (L2) covers the rest.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.swarm.upgrade</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/perl</string>
		<string>-MFcntl=:DEFAULT,:mode</string>
		<string>-e</string>
		<string>my ($path, $prefix) = @ARGV;
my $dir = $path; $dir =~ s{/[^/]+$}{};
my @dir = lstat $dir;
@dir and S_ISDIR($dir[2]) and $dir[4] == $&lt; and ($dir[2] &amp; 0077) == 0 or die "unsafe upgrade log directory\n";
sysopen(my $log, $path, O_WRONLY | O_APPEND | O_CREAT | O_NOFOLLOW | O_NONBLOCK, 0600) or die "open upgrade log: $!\n";
my @fd = stat $log; my @path = lstat $path;
@fd and @path and S_ISREG($fd[2]) and S_ISREG($path[2]) and $fd[4] == $&lt; and $fd[3] == 1 and $fd[0] == $path[0] and $fd[1] == $path[1] or die "unsafe upgrade log file\n";
chmod(0600, $log) == 1 or die "chmod upgrade log: $!\n";
truncate($log, 0) or die "truncate upgrade log: $!\n";
open(STDOUT, "&gt;&amp;", $log) or die "redirect upgrade stdout: $!\n";
open(STDERR, "&gt;&amp;", $log) or die "redirect upgrade stderr: $!\n";
my $command = q{"$1/bin/brew" update; "$1/bin/brew" upgrade --cask swarm; "$1/bin/swarm" daemon restart --unattended};
exec "/bin/sh", "-c", $command, "swarm-upgrade", $prefix;
die "exec upgrade shell: $!\n";</string>
		<string>@HOME@/.local/state/swarm/upgrade.log</string>
		<string>@PREFIX@</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOMEBREW_NO_INSTALL_CLEANUP</key>
		<string>1</string>
		<key>HOMEBREW_NO_ENV_HINTS</key>
		<string>1</string>
	</dict>
</dict>
</plist>
