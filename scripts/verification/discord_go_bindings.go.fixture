// Install in internal/discord of the disposable pinned Go repository.
package discord

import (
	"bytes"
	"crypto/sha256"
	"fmt"
	"path/filepath"
	"time"

	"github.com/Nathandela/swarm/internal/protocol/schema"
	"github.com/bwmarrin/discordgo"
	bolt "go.etcd.io/bbolt"
)

func FixtureOpenRead(dir string) (*Store, error) {
	db, err := bolt.Open(filepath.Join(dir, "discord.db"), 0600, &bolt.Options{ReadOnly: true})
	if err != nil {
		return nil, err
	}
	return &Store{db: db}, nil
}

func (s *Store) FixtureBind(d TeammateDiscussion) error {
	return s.teammateBind(teammateBinding{TeammateDiscussion: d, Opened: true})
}

func (s *Store) FixtureBinding(install, id string) (TeammateDiscussion, error) {
	row, err := s.teammateBindingByID(install, id)
	return row.TeammateDiscussion, err
}

func (s *Store) FixtureIngress(d TeammateDiscussion, owner, id, action string) (int, error) {
	route := d.Route
	route.MessageID = id
	record := teammateCandidate{Route: route, Author: Actor{ID: owner}}
	if err := s.teammateRecord(d.InstallationID, "synthetic-gateway", 1, []teammateCandidate{record}, false); err != nil {
		return 0, err
	}
	pending, _, err := s.teammatePendingSnapshot(d.InstallationID)
	if err != nil {
		return 0, err
	}
	if (action == "settle" || action == "settle-attachment") && len(pending) == 1 {
		msg := &discordgo.Message{ID: id, ChannelID: route.ChannelID, GuildID: route.GuildID,
			Content: "offline replay witness", Author: &discordgo.User{ID: owner}}
		if action == "settle-attachment" {
			msg.Attachments = []*discordgo.MessageAttachment{{ID: "901", Filename: "fixture.csv", ContentType: "text/csv",
				Size: len("header,value\nfixture,1\n"), URL: "https://cdn.discordapp.com/attachments/400/901/fixture.csv"}}
		}
		admission := &TeammateAdmission{Discussion: d, OperationID: "da_" + digest([]string{d.InstallationID, id})[:32],
			Revision: teammateRevision(msg), Author: record.Author, Route: route}
		if err := s.teammateCandidateChange(d.InstallationID, pending[0], StateSent, "", admission); err != nil {
			return 0, err
		}
	}
	return len(pending), nil
}

// FixturePendingPersonal uses the original connector's sending transaction but
// leaves ingress settlement to the migration candidate.
func (s *Store) FixturePendingPersonal(d TeammateDiscussion, owner, id string) (schema.MessageOrigin, error) {
	route := d.Route
	route.MessageID = id
	actor := Actor{ID: owner, Name: "offline fixture"}
	record := teammateCandidate{Route: route, Author: actor}
	if err := s.teammateRecord(d.InstallationID, "synthetic-gateway", 1, []teammateCandidate{record}, false); err != nil {
		return schema.MessageOrigin{}, err
	}
	pending, _, err := s.teammatePendingSnapshot(d.InstallationID)
	if err != nil {
		return schema.MessageOrigin{}, err
	}
	source := &discordgo.Message{ID: id, ChannelID: route.ChannelID, Content: "offline original owner prompt",
		Author: &discordgo.User{ID: owner, Username: actor.Name}}
	op, rev := "da_"+digest([]string{d.InstallationID, id})[:32], teammateRevision(source)
	admission := &TeammateAdmission{Discussion: d, OperationID: op, Revision: rev,
		Author: actor, Route: route, Authority: AuthorityOwnerDirect, InvokerID: owner, Sequence: pending[0].Sequence}
	origin := schema.MessageOrigin{Kind: string(admission.Authority), InstallationID: d.InstallationID,
		DiscussionID: d.ID, RequestID: op, ActorID: owner, ActorName: actor.Name, RequesterID: owner,
		ChannelID: route.ChannelID, MessageID: id, Revision: rev}
	return origin, s.teammateCandidateChange(d.InstallationID, pending[0], StateSending, "", admission)
}

func (s *Store) FixturePersonalGap(installation string) error {
	return s.db.Update(func(tx *bolt.Tx) error {
		return teammateCheckpointUpdate(tx, installation, "synthetic-reconnected-gateway", 2, true, "")
	})
}

func (s *Store) FixtureQueueFinal(d TeammateDiscussion, source string, attached bool) error {
	publication := TeammatePublication{ID: "fixture-final", Body: "Original final personal reply.",
		AdmissionID: "da_" + digest([]string{d.InstallationID, source})[:32], Sequence: 1}
	if attached {
		data := []byte("header,value\nfixture,1\n")
		publication.Files = []schema.PublicationFile{{ID: "original-file", Name: "fixture.csv", ContentType: "text/csv",
			SHA256: fmt.Sprintf("%x", sha256.Sum256(data)), Size: int64(len(data))}}
		return s.teammateQueueOutput(d, publication, time.Now().UTC(), data)
	}
	return s.teammateQueueOutput(d, publication, time.Now().UTC())
}

func (s *Store) FixtureFinalPayload(d TeammateDiscussion, damage bool) (int, error) {
	key := teammateOutputKey(d.InstallationID, d.ID, "fixture-final")
	size := 0
	if damage {
		err := s.db.Update(func(tx *bolt.Tx) error {
			bucket := tx.Bucket([]byte(teammateFilePayloadBucket))
			data := bytes.Clone(bucket.Get(key))
			if len(data) == 0 {
				return ErrNotFound
			}
			data[0] ^= 1
			return bucket.Put(key, data)
		})
		return 0, err
	}
	err := s.db.View(func(tx *bolt.Tx) error {
		if bucket := tx.Bucket([]byte(teammateFilePayloadBucket)); bucket != nil {
			size = len(bucket.Get(key))
		}
		return nil
	})
	return size, err
}

func (s *Store) FixtureFinalState(d TeammateDiscussion) (string, string, error) {
	var output teammateOutput
	err := s.db.View(func(tx *bolt.Tx) error {
		return teammateGet(tx.Bucket([]byte(teammateOutboxBucket)), teammateOutputKey(d.InstallationID, d.ID, "fixture-final"), &output)
	})
	if err != nil {
		return "", "", err
	}
	return output.Chunks[0].State, output.Chunks[0].ID, nil
}

func (s *Store) FixtureOutputPhases(d TeammateDiscussion) ([]string, error) {
	var phases []string
	err := s.db.View(func(tx *bolt.Tx) error {
		bucket := tx.Bucket([]byte(teammateOutboxBucket))
		return teammateEach(bucket, d.InstallationID+"\x00"+d.ID, func(key, _ []byte) error {
			var row teammateOutput
			if err := teammateGet(bucket, key, &row); err != nil {
				return err
			}
			for _, chunk := range row.Chunks {
				phases = append(phases, fmt.Sprintf("%s %t %s", chunk.State, row.ExportAck, chunk.ID))
			}
			return nil
		})
	})
	return phases, err
}
