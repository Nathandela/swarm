// Install in internal/discord of the disposable pinned Go repository.
package discord

import (
	"net/http"
	"strconv"

	"bytes"
	"context"
	"crypto/sha256"
	"encoding/json"
	"errors"
	"github.com/Nathandela/swarm/internal/voice"

	"fmt"
	"path/filepath"
	"time"

	"github.com/Nathandela/swarm/internal/protocol/schema"
	"github.com/bwmarrin/discordgo"
	bolt "go.etcd.io/bbolt"
)

func FixtureOpenRead(dir string) (*Store, error) {
	db, err := bolt.Open(filepath.Join(dir, "discord.db"), 0600, &bolt.Options{ReadOnly: true})
	if err != nil {
		return nil, err
	}
	return &Store{db: db}, nil
}

func (s *Store) FixtureBind(d TeammateDiscussion) error {
	return s.teammateBind(teammateBinding{TeammateDiscussion: d, Opened: true})
}

func (s *Store) FixtureBinding(install, id string) (TeammateDiscussion, error) {
	row, err := s.teammateBindingByID(install, id)
	return row.TeammateDiscussion, err
}

func (s *Store) FixtureIngressState(installation, discussion string) (map[string]any, error) {
	pending, err := s.teammatePending(installation)
	if err != nil {
		return nil, err
	}
	checkpoint, err := s.teammateCheckpoint(installation)
	if err != nil {
		return nil, err
	}
	binding, err := s.teammateBindingByID(installation, discussion)
	if err != nil {
		return nil, err
	}
	return map[string]any{"pending": pending, "checkpoint": checkpoint, "binding": binding}, nil
}

func (s *Store) FixtureIngress(d TeammateDiscussion, owner, id, action string) (int, error) {
	route := d.Route
	route.MessageID = id
	// An ordinary message dispatch has its channel and guild, without a parent.
	route.ParentID = ""
	record := teammateCandidate{Route: route, Author: Actor{ID: owner}}
	if action == "edit" {
		record.Edited = true
	}
	if err := s.teammateRecord(d.InstallationID, "synthetic-gateway", 1, []teammateCandidate{record}, false); err != nil {
		return 0, err
	}
	pending, _, err := s.teammatePendingSnapshot(d.InstallationID)
	if err != nil {
		return 0, err
	}
	if (action == "settle" || action == "settle-attachment") && len(pending) == 1 {
		msg := &discordgo.Message{ID: id, ChannelID: route.ChannelID, GuildID: route.GuildID,
			Content: "offline replay witness", Author: &discordgo.User{ID: owner}}
		if action == "settle-attachment" {
			msg.Attachments = []*discordgo.MessageAttachment{{ID: "901", Filename: "fixture.csv", ContentType: "text/csv",
				Size: len("header,value\nfixture,1\n"), URL: "https://cdn.discordapp.com/attachments/400/901/fixture.csv"}}
		}
		admission := &TeammateAdmission{Discussion: d, OperationID: "da_" + digest([]string{d.InstallationID, id})[:32],
			Revision: teammateRevision(msg), Author: record.Author, Route: route}
		if err := s.teammateCandidateChange(d.InstallationID, pending[0], StateSent, "", admission); err != nil {
			return 0, err
		}
	}
	return len(pending), nil
}

// FixturePendingPersonal uses the original connector's sending transaction but
// leaves ingress settlement to the migration candidate.
func (s *Store) FixturePendingPersonal(d TeammateDiscussion, owner, id string) (schema.MessageOrigin, error) {
	route := d.Route
	route.MessageID = id
	actor := Actor{ID: owner, Name: "offline fixture"}
	record := teammateCandidate{Route: route, Author: actor}
	if err := s.teammateRecord(d.InstallationID, "synthetic-gateway", 1, []teammateCandidate{record}, false); err != nil {
		return schema.MessageOrigin{}, err
	}
	pending, _, err := s.teammatePendingSnapshot(d.InstallationID)
	if err != nil {
		return schema.MessageOrigin{}, err
	}
	source := &discordgo.Message{ID: id, ChannelID: route.ChannelID, Content: "offline original owner prompt",
		Author: &discordgo.User{ID: owner, Username: actor.Name}}
	op, rev := "da_"+digest([]string{d.InstallationID, id})[:32], teammateRevision(source)
	admission := &TeammateAdmission{Discussion: d, OperationID: op, Revision: rev,
		Author: actor, Route: route, Authority: AuthorityOwnerDirect, InvokerID: owner, Sequence: pending[0].Sequence}
	origin := schema.MessageOrigin{Kind: string(admission.Authority), InstallationID: d.InstallationID,
		DiscussionID: d.ID, RequestID: op, ActorID: owner, ActorName: actor.Name, RequesterID: owner,
		ChannelID: route.ChannelID, MessageID: id, Revision: rev}
	return origin, s.teammateCandidateChange(d.InstallationID, pending[0], StateSending, "", admission)
}

// FixtureSettleAdmittedParent applies the ordinary connector cutover transition
// after the original Runtime reported durable native source custody.
func (s *Store) FixtureSettleAdmittedParent(d TeammateDiscussion, messageID string) error {
	pending, _, err := s.teammatePendingSnapshot(d.InstallationID)
	if err != nil {
		return err
	}
	for _, row := range pending {
		if row.Route.MessageID == messageID && row.Admission != nil && row.Admission.Discussion.ID == d.ID {
			return s.teammateCandidateChange(d.InstallationID, row, StateSent, "", nil)
		}
	}
	return fmt.Errorf("prepared parent admission is missing")
}

func (s *Store) FixturePersonalGap(installation string) error {
	return s.db.Update(func(tx *bolt.Tx) error {
		return teammateCheckpointUpdate(tx, installation, "synthetic-reconnected-gateway", 2, true, "")
	})
}

func (s *Store) FixtureQueueFinal(d TeammateDiscussion, source string, attached bool) error {
	publication := TeammatePublication{ID: "fixture-final", Body: "Original final personal reply.",
		AdmissionID: "da_" + digest([]string{d.InstallationID, source})[:32], Sequence: 1}
	if attached {
		data := []byte("header,value\nfixture,1\n")
		publication.Files = []schema.PublicationFile{{ID: "original-file", Name: "fixture.csv", ContentType: "text/csv",
			SHA256: fmt.Sprintf("%x", sha256.Sum256(data)), Size: int64(len(data))}}
		return s.teammateQueueOutput(d, publication, time.Now().UTC(), data)
	}
	return s.teammateQueueOutput(d, publication, time.Now().UTC())
}

// FixtureResumeVMFile runs Go's normal outbox resume without a transport. A
// settled file or an uncertain authentic receipt must never reach a sender.
func (s *Store) FixtureResumeVMFile(cfg Config, d TeammateDiscussion, uncertain bool) error {
	connector := teammateConnector{service: &Service{Config: cfg, Store: s, Now: time.Now}}
	err := connector.sendPending(context.Background(), d)
	if uncertain && errors.Is(err, ErrDeliveryUncertain) {
		return nil
	}
	if !uncertain && err == nil {
		return nil
	}
	return fmt.Errorf("unexpected Go file recovery outcome: %v", err)
}

// FixtureReadStagedVMFile reopens the ordinary old-Go outbox and its media payload.
func (s *Store) FixtureReadStagedVMFile(d TeammateDiscussion, phase string) ([][]byte, error) {
	var out teammateOutput
	err := s.db.View(func(tx *bolt.Tx) error {
		bucket := tx.Bucket([]byte(teammateOutboxBucket))
		prefix := []byte(d.InstallationID + "\x00" + d.ID + "\x00")
		c := bucket.Cursor()
		for key, raw := c.Seek(prefix); key != nil && bytes.HasPrefix(key, prefix); key, raw = c.Next() {
			var row teammateOutput
			if err := json.Unmarshal(raw, &row); err != nil {
				return err
			}
			if row.Publication.AttemptID == "" || len(row.Publication.Files) == 0 {
				continue
			}
			if out.Publication.ID != "" || !row.ExportAck || len(row.Chunks) != 1 || row.Chunks[0].State != phase {
				return ErrConflict
			}
			out = row
		}
		if out.Publication.ID == "" {
			return ErrNotFound
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	if phase == "sent" {
		err := s.db.View(func(tx *bolt.Tx) error {
			key := teammateOutputKey(d.InstallationID, d.ID, out.Publication.ID)
			if tx.Bucket([]byte(teammateFilePayloadBucket)).Get(key) != nil {
				return ErrConflict
			}
			return nil
		})
		return nil, err
	}
	return s.readFilePayload(d.InstallationID, out)
}

func (s *Store) FixtureFinalPayload(d TeammateDiscussion, damage bool) (int, error) {
	key := teammateOutputKey(d.InstallationID, d.ID, "fixture-final")
	size := 0
	if damage {
		err := s.db.Update(func(tx *bolt.Tx) error {
			bucket := tx.Bucket([]byte(teammateFilePayloadBucket))
			data := bytes.Clone(bucket.Get(key))
			if len(data) == 0 {
				return ErrNotFound
			}
			data[0] ^= 1
			return bucket.Put(key, data)
		})
		return 0, err
	}
	err := s.db.View(func(tx *bolt.Tx) error {
		if bucket := tx.Bucket([]byte(teammateFilePayloadBucket)); bucket != nil {
			size = len(bucket.Get(key))
		}
		return nil
	})
	return size, err
}

func (s *Store) FixtureFinalState(d TeammateDiscussion) (string, string, error) {
	var output teammateOutput
	err := s.db.View(func(tx *bolt.Tx) error {
		return teammateGet(tx.Bucket([]byte(teammateOutboxBucket)), teammateOutputKey(d.InstallationID, d.ID, "fixture-final"), &output)
	})
	if err != nil {
		return "", "", err
	}
	return output.Chunks[0].State, output.Chunks[0].ID, nil
}

func (s *Store) FixtureOutputPhases(d TeammateDiscussion) ([]string, error) {
	var phases []string
	err := s.db.View(func(tx *bolt.Tx) error {
		bucket := tx.Bucket([]byte(teammateOutboxBucket))
		return teammateEach(bucket, d.InstallationID+"\x00"+d.ID, func(key, _ []byte) error {
			var row teammateOutput
			if err := teammateGet(bucket, key, &row); err != nil {
				return err
			}
			for _, chunk := range row.Chunks {
				phases = append(phases, fmt.Sprintf("%s %t %s", chunk.State, row.ExportAck, chunk.ID))
			}
			return nil
		})
	})
	return phases, err
}

// FixtureVerifyQueuedOwner checks the original connector's final source guard.
func (s *Store) FixtureVerifyQueuedOwner(cfg Config, d TeammateDiscussion, origin schema.MessageOrigin) error {
	if origin.Kind != "owner_direct" || origin.InstallationID != cfg.InstallationID ||
		origin.DiscussionID != d.ID || origin.ChannelID != cfg.DMChannelID || origin.GuildID != "" ||
		origin.ActorID != cfg.OwnerID || origin.RequesterID != origin.ActorID {
		return ErrConflict
	}
	return s.db.View(func(tx *bolt.Tx) error {
		var guard teammateIngressGuard
		if err := teammateGet(tx.Bucket([]byte(teammateIngressGuardBucket)),
			teammateKey(cfg.InstallationID, origin.MessageID), &guard); err != nil {
			return err
		}
		if guard.Disposition != StateSent || guard.ActorID != origin.ActorID || guard.OperationID != origin.RequestID ||
			guard.Revision != origin.Revision || guard.DiscussionID != origin.DiscussionID ||
			guard.Route.ChannelID != origin.ChannelID || guard.Route.MessageID != origin.MessageID ||
			guard.Route.GuildID != "" || guard.LastChange != "" {
			return ErrConflict
		}
		return nil
	})
}

var fixtureBeforeGuildAdmit = errors.New("fixture stopped before native controller admission")

type fixtureGuildStopManager struct{ TeammateManager }

func (fixtureGuildStopManager) Admit(context.Context, TeammateAdmission, TeammateHistoryReader) error {
	return fixtureBeforeGuildAdmit
}

func (s *Store) FixtureGuildRecord(d TeammateDiscussion, id, actor, name string) error {
	route := d.Route
	route.ParentID, route.MessageID = "", id
	return s.teammateRecord(d.InstallationID, "synthetic-gateway", 1, []teammateCandidate{{
		Route: route, Author: Actor{ID: actor, Name: name},
	}}, false)
}

func (s *Store) FixtureDamageGuildBinding(installation, channel, field string) error {
	return s.db.Update(func(tx *bolt.Tx) error {
		key := teammateKey(installation, channel)
		var row map[string]json.RawMessage
		if err := teammateGet(tx.Bucket([]byte(teammateDiscussionBucket)), key, &row); err != nil {
			return err
		}
		switch field {
		case "ParentAnchor", "StartupNoticeID", "InputNoticeID":
			row[field] = json.RawMessage(`{}`)
		case "Starter":
			row[field] = json.RawMessage(`{"guild_id":{},"channel_id":"401","message_id":"500","parent_id":"399"}`)
		default:
			return ErrInvalid
		}
		return putJSON(tx, teammateDiscussionBucket, key, row)
	})
}

func (s *Store) FixtureGuildAdvance(ctx context.Context, cfg Config, manager TeammateManager, port, phase string) error {
	n, err := strconv.ParseUint(port, 10, 16)
	if err != nil || n == 0 || cfg.Mode != "teammate" {
		return ErrInvalid
	}
	client, err := NewDiscordClient("synthetic-unused-credential")
	if err != nil {
		return err
	}
	client.apiBase = "http://127.0.0.1:" + strconv.FormatUint(n, 10) + "/api/v10"
	client.http.Transport = &http.Transport{}
	client.http.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
	var bot discordgo.User
	if err := client.REST(ctx, http.MethodGet, "/users/@me", nil, &bot); err != nil {
		return err
	}
	if bot.ID != cfg.ApplicationID || !bot.Bot {
		return ErrConflict
	}
	service := NewService(cfg, s, nil, nil)
	service.SetBotID(bot.ID)
	connector := &teammateConnector{service: service, client: client, manager: manager}
	pending, err := s.teammatePending(cfg.InstallationID)
	if err != nil || len(pending) == 0 && phase == "advance" {
		return err
	}
	if len(pending) != 1 {
		return ErrConflict
	}
	c := pending[0]
	switch phase {
	case "stage":
		if c.State != StatePrepared {
			return ErrConflict
		}
		connector.manager = fixtureGuildStopManager{manager}
		if err := connector.process(ctx, c); !errors.Is(err, fixtureBeforeGuildAdmit) {
			return fmt.Errorf("did not reach connector sending commit: %w", err)
		}
		return nil
	case "accept":
		if c.State != StateSending || c.Admission == nil {
			return ErrConflict
		}
		return connector.process(ctx, c)
	case "advance":
		if c.State != teammateStateAccepted || c.Admission == nil {
			return ErrConflict
		}
		d := c.Admission.Discussion
		for ctx.Err() == nil {
			err = manager.Sync(ctx, d, connector.history(d), func(p TeammatePublication) error {
				return fmt.Errorf("unexpected publication %s", p.ID)
			})
			if err != nil && !errors.Is(err, voice.ErrControllerJournalResync) {
				return err
			}
			if err := connector.reconcileAccepted(ctx, c); err != nil {
				return err
			}
			current, err := s.teammatePending(cfg.InstallationID)
			if err != nil || len(current) == 0 {
				return err
			}
			time.Sleep(50 * time.Millisecond)
		}
		return ctx.Err()
	default:
		return ErrInvalid
	}
}
