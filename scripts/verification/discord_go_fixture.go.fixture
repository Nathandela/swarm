// Build inside a disposable copy of the pinned Go repository.
package main

import (
	"context"
	"encoding/binary"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"strconv"
	"time"

	"github.com/Nathandela/swarm/internal/discord"
	"github.com/Nathandela/swarm/internal/protocol/schema"
	"github.com/Nathandela/swarm/internal/skeleton"
	"github.com/Nathandela/swarm/internal/teammatemanager"
	"github.com/Nathandela/swarm/internal/voice"
	bolt "go.etcd.io/bbolt"
)

func check(err error) {
	if err != nil {
		panic(err)
	}
}

func main() {
	action, dir := os.Args[1], os.Args[2]
	target := discord.Target{ID: "ep-fixture/worker", Instance: "fixture-instance"}
	if action == "create" {
		root, mode := os.Args[3], os.Args[4]
		enabled, err := strconv.ParseBool(os.Args[5])
		check(err)
		check(os.MkdirAll(dir, 0700))
		token := filepath.Join(dir, "fixture-token")
		check(os.WriteFile(token, []byte("synthetic-unused-credential\n"), 0600))
		cfg := discord.Config{Version: 1, Enabled: enabled, Name: "fixture", Mode: mode,
			InstallationID: "fixture-" + mode, ApplicationID: "100", OwnerID: "200",
			ManagerCLI: "codex", TokenFile: token, DaemonSocket: filepath.Join(root, "daemon.sock"),
			WorkDir: root, Supervisor: &discord.SupervisorPaths{StateDir: root, Lock: filepath.Join(root, "daemon.lock"), Log: filepath.Join(root, "daemon.log")}}
		if len(os.Args) == 7 {
			cfg.WorkDir = os.Args[6]
		}
		if mode == "teammate" {
			cfg.GuildIDs = []string{"300"}
		} else {
			cfg.DMChannelID = "400"
		}
		check(discord.SaveConfig(dir, cfg))
		check(discord.SelectState(root, dir))
		store, err := discord.OpenStore(dir)
		check(err)
		check(store.SetOptOut(target, true))
		check(store.Close())
		return
	}
	if action == "project-add" {
		cfg, err := discord.LoadConfig(dir)
		check(err)
		if cfg.Projects == nil {
			cfg.Projects = map[string]string{}
		}
		cfg.Projects[os.Args[3]] = os.Args[4]
		check(discord.SaveConfig(dir, cfg))
		return
	}
	if action == "project" {
		cfg, err := discord.LoadConfig(dir)
		check(err)
		cfg.Projects = nil
		if os.Args[3] != "remove" {
			cfg.Projects = map[string]string{"former": os.Args[3]}
		}
		check(discord.SaveConfig(dir, cfg))
		return
	}
	if action == "voice-phase" {
		phase, cutover, err := voice.FixturePersonalPhase(dir, os.Args[3])
		check(err)
		fmt.Println(phase, cutover)
		return
	}
	if action == "pending" || action == "pending-count" {
		db, err := bolt.Open(filepath.Join(dir, "discord.db"), 0600, nil)
		check(err)
		check(db.Update(func(tx *bolt.Tx) error {
			if action == "pending-count" {
				count, err := strconv.ParseUint(os.Args[3], 10, 64)
				if err != nil {
					return err
				}
				return tx.Bucket([]byte("teammate_meta")).Put([]byte("active_ingress_count"), binary.BigEndian.AppendUint64(nil, count))
			}
			return tx.Bucket([]byte("teammate_pending")).Put([]byte("fixture\000pending"), []byte("fixture-ingress"))
		}))
		check(db.Close())
		return
	}
	open := discord.OpenStore
	if action == "route" || action == "read" || action == "traffic-read" || action == "audience-read" || action == "publication-read" || action == "publication-phases" || action == "publication-payload" {
		open = discord.FixtureOpenRead
	}
	store, err := open(dir)
	check(err)
	defer store.Close()
	switch action {
	case "audience-read":
		out, err := store.IsOptedOut(discord.Target{ID: os.Args[3], Instance: "offline-verification"})
		check(err)
		fmt.Println(out)
	case "audience-write":
		excluded, err := strconv.ParseBool(os.Args[4])
		check(err)
		check(store.SetOptOut(discord.Target{ID: os.Args[3], Instance: "offline-verification"}, excluded))

	case "bind":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		id, channel := os.Args[3], os.Args[4]
		var socket string
		if len(os.Args) == 6 {
			socket = os.Args[5]
		}
		route := discord.Route{ChannelID: channel}
		if cfg.Mode == "teammate" {
			route.GuildID = "300"
		}
		starter := route
		starter.MessageID = "500"
		check(store.FixtureBind(discord.TeammateDiscussion{ID: id, InstallationID: cfg.InstallationID,
			Route: route, Starter: starter, SupervisorSocket: socket}))
	case "ingress-gap":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		check(store.FixturePersonalGap(cfg.InstallationID))
	case "ingress":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		count, err := store.FixtureIngress(row, cfg.OwnerID, os.Args[4], os.Args[5])
		check(err)
		fmt.Println(count)
	case "activate":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		ctx, cancel := context.WithTimeout(context.Background(), 75*time.Second)
		defer cancel()
		root := cfg.Supervisor.StateDir
		manager, err := teammatemanager.New(ctx, dir, skeleton.EndpointIDForStateDir(root), root, cfg)
		check(err)
		defer manager.Close()
		binding, err := manager.FixtureActivate(ctx, row)
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(binding))
	case "publication-queue", "publication-read", "publication-phases", "publication-payload", "publication-damage":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		if action == "publication-queue" {
			check(store.FixtureQueueFinal(row, os.Args[4], len(os.Args) == 6 && os.Args[5] == "attachment"))
		} else if action == "publication-payload" || action == "publication-damage" {
			size, err := store.FixtureFinalPayload(row, action == "publication-damage")
			check(err)
			fmt.Println(size)
		} else if action == "publication-phases" {
			phases, err := store.FixtureOutputPhases(row)
			check(err)
			check(json.NewEncoder(os.Stdout).Encode(phases))
		} else {
			state, nonce, err := store.FixtureFinalState(row)
			check(err)
			fmt.Println(state, nonce)
		}
	case "voice-ingress":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		var origin schema.MessageOrigin
		if os.Args[5] != "quiet" {
			origin, err = store.FixturePendingPersonal(row, cfg.OwnerID, os.Args[4])
			check(err)
		}
		root := filepath.Join(dir, "discussions")
		check(os.Mkdir(root, 0700))
		endpoint := skeleton.EndpointIDForStateDir(cfg.Supervisor.StateDir)
		id := teammatemanager.CheckoutDiscussionLedgerID(root, endpoint, cfg.InstallationID, "", cfg.DMChannelID, row.ID)
		phase := os.Args[5]
		if phase == "quiet-pending" {
			phase = "quiet"
		}
		project := ""
		if phase == "project-final" || phase == "attempt-final" {
			project = os.Args[6]
		}
		check(voice.FixturePersonalIngress(filepath.Join(root, id), "discord-teammate-"+id, endpoint+"/fixture-manager", origin, phase, project))
	case "route":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		endpoint, socket, state, err := teammatemanager.FixtureSupervisor(cfg, row)
		check(err)
		fmt.Println(endpoint, socket, state)

	case "traffic":
		phase := os.Args[3]
		now := time.Now().UTC()
		request := discord.Request{EventID: "event-" + phase, MessageRevision: "revision", EventAt: now,
			Author: discord.Actor{ID: "200", Name: "synthetic"}, Authority: discord.AuthorityExternal,
			Route:  discord.Route{GuildID: "300", ChannelID: "400", MessageID: "500"},
			Target: discord.Target{ID: "ep-fixture/another-worker", Instance: "fixture-live"},
			Text:   "synthetic-unused-credential"}
		row, fresh, err := store.Admit(request, now)
		check(err)
		if !fresh {
			panic("fixture was already prepared")
		}
		_, fresh, err = store.BeginDelivery(row.Ref, now)
		check(err)
		if !fresh {
			panic("fixture was already submitted")
		}
		check(store.FinishDelivery(row.Ref, phase, "synthetic-outcome"))
	case "traffic-read":
		row, err := store.ExistingEvent("event-"+os.Args[3], time.Now().UTC())
		check(err)
		fmt.Println(row.DeliveryState)
	case "change":
		check(store.SetOptOut(target, false))
	case "read":
		out, err := store.IsOptedOut(target)
		check(err)
		fmt.Println(out)
	}
}
