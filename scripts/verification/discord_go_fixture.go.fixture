// Build inside a disposable copy of the pinned Go repository.
package main

import (
	"context"
	"encoding/binary"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strconv"
	"time"

	"github.com/Nathandela/swarm/internal/discord"
	"github.com/Nathandela/swarm/internal/protocol/schema"
	"github.com/Nathandela/swarm/internal/skeleton"
	"github.com/Nathandela/swarm/internal/teammatemanager"
	"github.com/Nathandela/swarm/internal/voice"
	"github.com/Nathandela/swarm/internal/workermail"
	bolt "go.etcd.io/bbolt"
)

func check(err error) {
	if err != nil {
		panic(err)
	}
}

func main() {
	action, dir := os.Args[1], os.Args[2]
	target := discord.Target{ID: "ep-fixture/worker", Instance: "fixture-instance"}
	if action == "create" {
		root, mode := os.Args[3], os.Args[4]
		enabled, err := strconv.ParseBool(os.Args[5])
		check(err)
		check(os.MkdirAll(dir, 0700))
		token := filepath.Join(dir, "fixture-token")
		check(os.WriteFile(token, []byte("synthetic-unused-credential\n"), 0600))
		cfg := discord.Config{Version: 1, Enabled: enabled, Name: "fixture", Mode: mode,
			InstallationID: "fixture-" + mode, ApplicationID: "100", OwnerID: "200",
			ManagerCLI: "codex", TokenFile: token, DaemonSocket: filepath.Join(root, "daemon.sock"),
			WorkDir: root, Supervisor: &discord.SupervisorPaths{StateDir: root, Lock: filepath.Join(root, "daemon.lock"), Log: filepath.Join(root, "daemon.log")}}
		if len(os.Args) == 7 {
			cfg.WorkDir = os.Args[6]
		}
		if mode == "teammate" {
			cfg.GuildIDs = []string{"300"}
		} else {
			cfg.DMChannelID = "400"
		}
		check(discord.SaveConfig(dir, cfg))
		check(discord.SelectState(root, dir))
		store, err := discord.OpenStore(dir)
		check(err)
		check(store.SetOptOut(target, true))
		check(store.Close())
		return
	}
	if action == "worker-file" || action == "worker-file-read" {
		checkout := os.Args[3]
		binding := workermail.Binding{Discussion: os.Args[5], Parent: "fixture-manager",
			Session: "fixture-endpoint/fixture-worker", Instance: "fixture-instance",
			Attempt: "vm-child-fixture", Agent: "codex", Project: checkout}
		if action == "worker-file-read" {
			note, err := workermail.Lookup(dir, binding, "fixture-note")
			check(err)
			data, err := workermail.ReadFile(dir, binding, note.ID, note.Files[0].ID)
			check(err)
			_, err = os.Stdout.Write(data)
			check(err)
		} else {
			files, err := workermail.CaptureFiles(checkout, []string{os.Args[4]})
			check(err)
			_, err = workermail.Submit(dir, binding, "fixture-note", "complete", "Fixture file", true, files...)
			check(err)
		}
		return
	}
	if action == "vm-pin-count" {
		pinned, err := bolt.Open(filepath.Join(dir, "dispatcher-mail.db"), 0600,
			&bolt.Options{ReadOnly: true, Timeout: time.Second})
		check(err)
		defer pinned.Close()
		count := 0
		check(pinned.View(func(tx *bolt.Tx) error {
			return tx.Bucket([]byte("note-files")).ForEach(func(k, v []byte) error {
				if v != nil {
					return nil
				}
				raw := tx.Bucket([]byte("note-files")).Bucket(k).Get([]byte("manifest"))
				var row struct{ Pins map[string][]string }
				if err := json.Unmarshal(raw, &row); err != nil {
					return err
				}
				if ids := row.Pins[os.Args[3]]; len(ids) != 0 {
					if len(ids) != 1 || ids[0] != os.Args[4] {
						return fmt.Errorf("unexpected worker file pin")
					}
					count++
				}
				return nil
			})
		}))
		fmt.Println(count)
		return
	}
	if action == "vm-replace-prepared-queued-operation" {
		check(voice.FixtureReplacePreparedOperation(dir, os.Args[3], os.Args[4], os.Args[5], os.Args[6], os.Args[7], os.Args[8]))
		return
	}
	if action == "vm-read-prepared-queued-wake" {
		operation, payload, err := voice.FixturePreparedQueuedWake(
			dir, os.Args[3], os.Args[4], os.Args[5], os.Args[6], os.Args[7], os.Args[8], os.Args[9] == "pending")
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(struct {
			Operation string
			Files     [][]byte
		}{operation, payload}))
		return
	}
	if action == "vm-validate-staged-wake" {
		data, err := voice.FixtureValidateStagedFileWake(dir, os.Args[3])
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(data))
		return
	}
	if action == "vm-read-admitted-wake" {
		data, err := voice.FixtureAdmittedFileWake(dir, os.Args[3])
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(data))
		return
	}
	if action == "project-access" {
		cfg, err := discord.LoadConfig(dir)
		check(err)
		cfg.ProjectAccess = os.Args[3]
		check(discord.SaveConfig(dir, cfg))
		return
	}
	if action == "project-add" {
		cfg, err := discord.LoadConfig(dir)
		check(err)
		if cfg.Projects == nil {
			cfg.Projects = map[string]string{}
		}
		cfg.Projects[os.Args[3]] = os.Args[4]
		check(discord.SaveConfig(dir, cfg))
		return
	}
	if action == "project" {
		cfg, err := discord.LoadConfig(dir)
		check(err)
		cfg.Projects = nil
		if os.Args[3] != "remove" {
			cfg.Projects = map[string]string{"former": os.Args[3]}
		}
		check(discord.SaveConfig(dir, cfg))
		return
	}
	if action == "vm-reply-noise" {
		clock, err := strconv.ParseInt(os.Args[5], 10, 64)
		check(err)
		state, err := voice.FixtureReplyNoise(dir, os.Args[3], os.Args[4], time.Unix(clock, 0).UTC())
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(state))
		return
	}
	if action == "voice-phase" {
		phase, cutover, err := voice.FixturePersonalPhase(dir, os.Args[3])
		check(err)
		fmt.Println(phase, cutover)
		return
	}
	if action == "guild-malform-timestamp" {
		check(voice.FixtureDamageGuildNative(dir, os.Args[3], os.Args[4]))
		return
	}
	if action == "guild-mismatch-nonce" {
		check(voice.FixtureDamageGuildNative(dir, os.Args[3], "nonce"))
		return
	}
	if action == "guild-native" || action == "guild-native-request" {
		row, err := voice.FixtureGuildNativeAdmission(dir, os.Args[3])
		check(err)
		if action == "guild-native-request" {
			_, err = os.Stdout.Write(row.Request)
			check(err)
		} else {
			check(json.NewEncoder(os.Stdout).Encode(row))
		}
		return
	}
	if action == "pending" || action == "pending-count" {
		db, err := bolt.Open(filepath.Join(dir, "discord.db"), 0600, nil)
		check(err)
		check(db.Update(func(tx *bolt.Tx) error {
			if action == "pending-count" {
				count, err := strconv.ParseUint(os.Args[3], 10, 64)
				if err != nil {
					return err
				}
				return tx.Bucket([]byte("teammate_meta")).Put([]byte("active_ingress_count"), binary.BigEndian.AppendUint64(nil, count))
			}
			return tx.Bucket([]byte("teammate_pending")).Put([]byte("fixture\000pending"), []byte("fixture-ingress"))
		}))
		check(db.Close())
		return
	}
	if action == "bridge-lease" {
		ctx, cancel := context.WithCancel(context.Background())
		cancel()
		check((&discord.Service{}).ServeLocal(ctx, dir))
		return
	}
	open := discord.OpenStore
	if action == "route" || action == "read" || action == "traffic-read" || action == "audience-read" || action == "ingress-state" || action == "publication-read" || action == "publication-phases" || action == "publication-payload" || action == "vm-verify-queued-file" || action == "guild-gap-receipt" {
		open = discord.FixtureOpenRead
	}
	store, err := open(dir)
	check(err)
	defer store.Close()
	switch action {
	case "guild-gap-start", "guild-gap-seal", "guild-gap-receipt", "guild-gap-settle":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, "original-room")
		check(err)
		switch action {
		case "guild-gap-start":
			check(store.FixtureStartGuildGap(cfg.InstallationID))
		case "guild-gap-seal":
			check(store.FixtureAcknowledgeGuildGap(row))
		case "guild-gap-receipt":
			raw, err := store.FixtureGuildGapReceipt(row)
			check(err)
			_, err = os.Stdout.Write(raw)
			check(err)
		case "guild-gap-settle":
			check(store.FixtureSettleAdmittedParent(row, "701"))
		}
	case "guild-record":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		check(store.FixtureGuildRecord(row, os.Args[4], os.Args[5], os.Args[6]))
	case "guild-damage-binding":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		check(store.FixtureDamageGuildBinding(cfg.InstallationID, "401", os.Args[3]))
	case "guild-advance":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		ctx, cancel := context.WithTimeout(context.Background(), 28*time.Second)
		defer cancel()
		root := cfg.Supervisor.StateDir
		manager, err := teammatemanager.New(ctx, dir, skeleton.EndpointIDForStateDir(root), root, cfg)
		check(err)
		defer manager.Close()
		if os.Args[4] == "advance" && len(os.Args) == 6 {
			row, err := store.FixtureBinding(cfg.InstallationID, "original-room")
			check(err)
			check(manager.FixtureWithholdGuildAck(ctx, row, os.Args[5]))
		}
		if os.Args[4] == "prepare-native" {
			row, err := store.FixtureBinding(cfg.InstallationID, "original-room")
			check(err)
			var stop context.CancelFunc
			ctx, stop, err = manager.FixtureStopBeforeGuildSend(ctx, row, "701")
			check(err)
			defer stop()
		}
		var cursor []string
		if os.Args[4] == "history" {
			cursor = os.Args[5:]
		}
		check(store.FixtureGuildAdvance(ctx, cfg, manager, os.Args[3], os.Args[4], cursor...))
	case "audience-read":
		out, err := store.IsOptedOut(discord.Target{ID: os.Args[3], Instance: "offline-verification"})
		check(err)
		fmt.Println(out)
	case "audience-write":
		excluded, err := strconv.ParseBool(os.Args[4])
		check(err)
		check(store.SetOptOut(discord.Target{ID: os.Args[3], Instance: "offline-verification"}, excluded))

	case "bind", "bind-thread":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		id, channel := os.Args[3], os.Args[4]
		var socket string
		if action == "bind" && len(os.Args) == 6 {
			socket = os.Args[5]
		}
		route := discord.Route{ChannelID: channel}
		if cfg.Mode == "teammate" {
			route.GuildID = "300"
		}
		if action == "bind-thread" {
			route.ParentID = os.Args[5]
			socket = cfg.DaemonSocket
		}
		starter := route
		starter.MessageID = "500"
		check(store.FixtureBind(discord.TeammateDiscussion{ID: id, InstallationID: cfg.InstallationID,
			Route: route, Starter: starter, SupervisorSocket: socket}))
	case "ingress-gap":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		check(store.FixturePersonalGap(cfg.InstallationID))
	case "ingress-state":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		state, err := store.FixtureIngressState(cfg.InstallationID, os.Args[3])
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(state))
	case "ingress":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		count, err := store.FixtureIngress(row, cfg.OwnerID, os.Args[4], os.Args[5])
		check(err)
		fmt.Println(count)
	case "activate":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		ctx, cancel := context.WithTimeout(context.Background(), 75*time.Second)
		defer cancel()
		root := cfg.Supervisor.StateDir
		manager, err := teammatemanager.New(ctx, dir, skeleton.EndpointIDForStateDir(root), root, cfg)
		check(err)
		defer manager.Close()
		binding, err := manager.FixtureActivate(ctx, row)
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(binding))
	case "vm-controller-run":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		if cfg.ProjectAccess != discord.ProjectAccessVM {
			panic("expected original Go VM enrollment")
		}
		origin, err := store.FixturePendingPersonal(row, cfg.OwnerID, os.Args[4])
		check(err)
		ctx, cancel := context.WithTimeout(context.Background(), 110*time.Second)
		defer cancel()
		root := cfg.Supervisor.StateDir
		manager, err := teammatemanager.New(ctx, dir, skeleton.EndpointIDForStateDir(root), root, cfg)
		check(err)
		defer manager.Close()
		source := os.Args[4]
		reader := func(_ context.Context, q discord.TeammateHistoryQuery) (discord.TeammateHistoryPage, error) {
			switch q.Source {
			case "audience", "thread":
				return discord.TeammateHistoryPage{}, nil
			case "admission", "grant", "expected_reply":
				if q.AdmissionID == origin.RequestID && q.Revision == origin.Revision &&
					q.MessageID == source && q.AuthorID == cfg.OwnerID {
					return discord.TeammateHistoryPage{}, nil
				}
			}
			return discord.TeammateHistoryPage{}, discord.ErrTeammateSourceChanged
		}
		route := row.Route
		route.MessageID = source
		admission := discord.TeammateAdmission{
			Discussion: row, OperationID: origin.RequestID, Revision: origin.Revision,
			Text: "offline original owner prompt", Route: route,
			Author:    discord.Actor{ID: cfg.OwnerID, Name: origin.ActorName},
			InvokerID: cfg.OwnerID, Authority: discord.AuthorityOwnerDirect,
		}
		check(manager.Admit(ctx, admission, reader))
		settledParent := false
		for ctx.Err() == nil {
			if _, err := os.Stat(os.Args[5]); err == nil {
				if !settledParent {
					panic("the original owner admission did not settle before handoff")
				}
				return
			}
			err = manager.Sync(ctx, row, reader, func(output discord.TeammatePublication) error {
				return fmt.Errorf("unexpected original Go publication before rollover: %s", output.ID)
			})
			if err != nil && !errors.Is(err, voice.ErrControllerJournalResync) {
				check(err)
			}
			if !settledParent {
				phase, err := manager.AdmissionState(ctx, admission)
				check(err)
				if phase == discord.TeammateAdmissionCutover {
					check(store.FixtureSettleAdmittedParent(row, source))
					settledParent = true
					if len(os.Args) == 7 {
						check(os.WriteFile(os.Args[6], []byte("ready"), 0600))
					}
				}
			}
			if settledParent && len(os.Args) > 7 && os.Args[7] == "completed-parent" {
				done, err := manager.FixtureNativeParentSettled(row, source)
				check(err)
				if done {
					check(os.WriteFile(os.Args[6], []byte("ready"), 0600))
					return
				}
			}
			time.Sleep(40 * time.Millisecond)
		}
		check(ctx.Err())
	case "vm-verify-queued-file":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		origin, note, payload, err := voice.FixtureQueuedFileWitness(os.Args[4], cfg.Supervisor.StateDir, os.Args[5])
		check(err)
		check(store.FixtureVerifyQueuedOwner(cfg, row, origin))
		forged := origin
		forged.ActorID = "300"
		if err := store.FixtureVerifyQueuedOwner(cfg, row, forged); err == nil {
			panic("foreign actor qualified for the queued file")
		}
		check(json.NewEncoder(os.Stdout).Encode(struct {
			Note  workermail.Note
			Files [][]byte
		}{note, payload}))
	case "vm-resume-publication":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		check(store.FixtureResumeVMFile(cfg, row, os.Args[4] == "uncertain"))
	case "vm-read-staged-publication":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		payload, err := store.FixtureReadStagedVMFile(row, os.Args[4])
		check(err)
		check(json.NewEncoder(os.Stdout).Encode(payload))
	case "publication-queue", "publication-read", "publication-phases", "publication-payload", "publication-damage":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		if action == "publication-queue" {
			var attachment string
			if len(os.Args) == 6 {
				attachment = os.Args[5]
			}
			check(store.FixtureQueueFinal(row, os.Args[4], attachment))
		} else if action == "publication-payload" || action == "publication-damage" {
			size, err := store.FixtureFinalPayload(row, action == "publication-damage")
			check(err)
			fmt.Println(size)
		} else if action == "publication-phases" {
			phases, err := store.FixtureOutputPhases(row)
			check(err)
			check(json.NewEncoder(os.Stdout).Encode(phases))
		} else {
			state, nonce, err := store.FixtureFinalState(row)
			check(err)
			fmt.Println(state, nonce)
		}
	case "vm-reply-progress":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, "original-room")
		check(err)
		check(store.FixtureObserveReplyProgress(row, os.Args[3] == "compact"))
	case "voice-ingress":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		var origin schema.MessageOrigin
		if os.Args[5] != "quiet" {
			origin, err = store.FixturePendingPersonal(row, cfg.OwnerID, os.Args[4])
			check(err)
		}
		root := filepath.Join(dir, "discussions")
		check(os.Mkdir(root, 0700))
		endpoint := skeleton.EndpointIDForStateDir(cfg.Supervisor.StateDir)
		id := teammatemanager.CheckoutDiscussionLedgerID(root, endpoint, cfg.InstallationID, "", cfg.DMChannelID, row.ID)
		phase := os.Args[5]
		if phase == "quiet-pending" {
			phase = "quiet"
		}
		project := ""
		if phase == "project-final" || phase == "attempt-final" {
			project = os.Args[6]
		}
		check(voice.FixturePersonalIngress(filepath.Join(root, id), "discord-teammate-"+id, endpoint+"/fixture-manager", origin, phase, project))
	case "route":
		cfg, err := discord.LoadConfig(dir)
		check(err)
		row, err := store.FixtureBinding(cfg.InstallationID, os.Args[3])
		check(err)
		endpoint, socket, state, err := teammatemanager.FixtureSupervisor(cfg, row)
		check(err)
		fmt.Println(endpoint, socket, state)

	case "traffic":
		phase := os.Args[3]
		now := time.Now().UTC()
		request := discord.Request{EventID: "event-" + phase, MessageRevision: "revision", EventAt: now,
			Author: discord.Actor{ID: "200", Name: "synthetic"}, Authority: discord.AuthorityExternal,
			Route:  discord.Route{GuildID: "300", ChannelID: "400", MessageID: "500"},
			Target: discord.Target{ID: "ep-fixture/another-worker", Instance: "fixture-live"},
			Text:   "synthetic-unused-credential"}
		row, fresh, err := store.Admit(request, now)
		check(err)
		if !fresh {
			panic("fixture was already prepared")
		}
		_, fresh, err = store.BeginDelivery(row.Ref, now)
		check(err)
		if !fresh {
			panic("fixture was already submitted")
		}
		check(store.FinishDelivery(row.Ref, phase, "synthetic-outcome"))
	case "traffic-read":
		row, err := store.ExistingEvent("event-"+os.Args[3], time.Now().UTC())
		check(err)
		fmt.Println(row.DeliveryState)
	case "change":
		check(store.SetOptOut(target, false))
	case "read":
		out, err := store.IsOptedOut(target)
		check(err)
		fmt.Println(out)
	}
}
