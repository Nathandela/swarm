// Install in internal/voice of the disposable pinned Go repository.
package voice

import (
	"context"
	"crypto/sha256"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"time"

	"github.com/Nathandela/swarm/internal/protocol"
	"github.com/Nathandela/swarm/internal/protocol/schema"
	"github.com/Nathandela/swarm/internal/workermail"
	bolt "go.etcd.io/bbolt"
)

type fixtureWithheldGuildAck struct {
	*ProtocolControllerClient
	ctx    context.Context
	marker string
}

func (r fixtureWithheldGuildAck) SemanticSend(operation string, request protocol.ComposerSendReq) error {
	if request.ManagerAdmission == nil {
		return ErrInvalid
	}
	if err := r.ProtocolControllerClient.SemanticSend(operation, request); err != nil {
		return err
	}
	receipt, err := json.Marshal(map[string]any{"pid": os.Getpid(), "operation": operation, "nonce": request.ManagerAdmission.Nonce})
	if err != nil {
		return err
	}
	if err := os.WriteFile(r.marker, receipt, 0600); err != nil {
		return err
	}
	// The real supervisor already replied. Leave the controller at its durable executing cut.
	<-r.ctx.Done()
	return r.ctx.Err()
}

func (d *DiscussionController) FixtureWithholdGuildAck(ctx context.Context, marker string) error {
	for _, namespace := range []string{"net", "pid"} {
		current, err := os.Readlink("/proc/self/ns/" + namespace)
		if err != nil {
			return err
		}
		outer, err := strconv.ParseUint(os.Getenv("SWARM_NATIVE_FIXTURE_HOST_"+strings.ToUpper(namespace)+"NS"), 10, 64)
		if err != nil || outer == 0 || current == fmt.Sprintf("%s:[%d]", namespace, outer) {
			return ErrInvalid
		}
	}
	d.mu.Lock()
	defer d.mu.Unlock()
	if d.controller == nil {
		return ErrStale
	}
	client, ok := d.controller.runtime.(*ProtocolControllerClient)
	if !ok {
		return ErrStale
	}
	d.controller.runtime = fixtureWithheldGuildAck{client, ctx, marker}
	return nil
}

type fixtureGuildBeforeSend struct {
	context.Context
	cancel  context.CancelFunc
	store   *Store
	message string
}

type fixtureRejectGuildSend struct{ *ProtocolControllerClient }

func (fixtureRejectGuildSend) SemanticSend(string, protocol.ComposerSendReq) error {
	return errors.New("pre-send fixture reached the native submission boundary")
}

func (c fixtureGuildBeforeSend) Err() error {
	if c.Context.Err() != nil {
		return c.Context.Err()
	}
	state, err := c.store.readView()
	if err != nil {
		c.cancel()
		return c.Context.Err()
	}
	for _, row := range state.Admissions {
		if row.Origin != nil && row.Origin.MessageID == c.message && row.Phase == "prepared" && !row.SourceCutover {
			c.cancel()
			break
		}
	}
	return c.Context.Err()
}

func (d *DiscussionController) FixtureStopBeforeGuildSend(ctx context.Context, message string) (context.Context, context.CancelFunc, error) {
	d.mu.Lock()
	defer d.mu.Unlock()
	if d.controller == nil {
		return nil, nil, ErrStale
	}
	client, ok := d.controller.runtime.(*ProtocolControllerClient)
	if !ok {
		return nil, nil, ErrStale
	}
	d.controller.runtime = fixtureRejectGuildSend{client}
	ctx, cancel := context.WithCancel(ctx)
	return fixtureGuildBeforeSend{ctx, cancel, d.store, message}, cancel, nil
}

func FixturePersonalIngress(dir, conversation, session string, origin schema.MessageOrigin, phase, project string) error {
	store, err := OpenStore(dir)
	if err != nil {
		return err
	}
	defer store.Close()
	binding, err := store.BindManager(ManagerBinding{ConversationID: conversation,
		Provider: "codex", SessionID: session, SessionInstance: "original-manager-instance",
		NativeSessionID: "original-native-session", NativeGeneration: "native-1",
		ObservationGeneration: "observed-1", LoginEpoch: "same-login"})
	if err != nil {
		return err
	}
	if phase == "quiet" {
		return store.observeController(binding, 0, false)
	}
	controller := Controller{store: store, binding: binding, discussion: &DiscussionScope{
		DiscussionID: origin.DiscussionID, InstallationID: origin.InstallationID,
		DMOwnerID: origin.ActorID, ThreadID: origin.ChannelID,
	}}
	const body = "offline original owner prompt"
	admissionProject := project
	if phase == "attempt-final" {
		admissionProject = ""
	}
	admission, err := controller.submitDiscussionInProject(origin, body, body, "", "", admissionProject, admissionProject != "")
	if err != nil {
		return err
	}
	if err := store.observeController(binding, 0, false); err != nil {
		return err
	}
	nonce := strings.Repeat("1", 64)
	op, err := protocol.NewSemanticOperationID()
	if err != nil {
		return err
	}
	request := protocol.ComposerSendReq{Session: binding.SessionID, SessionInstance: binding.SessionInstance,
		Origin: &origin, Text: body, ManagerAdmission: &schema.ManagerAdmission{Binding: runtimeBinding(binding), Nonce: nonce}}
	prepared, err := store.prepareControllerInput(binding, admission.Sequence, nonce, op, request, 0)
	if err != nil || phase == "prepared" {
		return err
	}
	if err := store.beginControllerInput(binding, prepared); err != nil || phase == "executing" {
		return err
	}
	turn := "synthetic-observed-turn"
	if err := store.controllerInputPhase(binding, admission.Sequence, "running", turn, ""); err != nil || !strings.HasSuffix(phase, "final") {
		return err
	}
	if phase == "attempt-final" {
		const id = "fixture-attempt"
		raw, err := json.Marshal(controllerActionRequest{Tool: "swarm_create", Origin: &origin,
			Project: project, Arguments: json.RawMessage("{}"), Launch: &protocol.LaunchReq{Agent: "codex", Cwd: project}})
		if err != nil {
			return err
		}
		action, err := protocol.NewLaunchOperationID()
		if err != nil {
			return err
		}
		if _, err := store.PrepareAction(binding, Action{ID: id, Admission: admission.Sequence,
			NativeInputID: nonce, Target: project, OperationID: action, Request: raw}); err != nil {
			return err
		}
		owner, _, _ := strings.Cut(session, "/")
		result, err := json.Marshal(createdWorkerResult{State: "created", Session: owner + "/fixture-worker", SessionInstance: "fixture-worker-instance"})
		if err != nil {
			return err
		}
		if err := store.SettleAction(binding, id, result); err != nil {
			return err
		}
		if err := store.update(func(st *State) error {
			k := admissionKey(conversation, admission.Sequence)
			current := st.Admissions[k]
			current.WorkerAttempts = addDiscussionScopeValue(current.WorkerAttempts, id)
			putRecord(st, "admissions", &st.Admissions, k, current)
			return nil
		}); err != nil {
			return err
		}
	}
	permit, err := store.controllerSpeechPermit(binding, admission.Sequence, nonce, turn)
	if err != nil {
		return err
	}
	publication := Publication{Admission: admission.Sequence, ID: "fixture-final",
		NativeTurnID: turn, Sequence: 1, Text: "Original final personal reply.", Final: true}
	if phase == "attachment-final" {
		data := []byte("header,value\nfixture,1\n")
		files := []schema.PublicationFile{{ID: "original-file", Name: "fixture.csv", ContentType: "text/csv",
			SHA256: fmt.Sprintf("%x", sha256.Sum256(data)), Size: int64(len(data))}}
		raw, err := json.Marshal(files)
		if err != nil {
			return err
		}
		publication.DiscussionFiles = string(raw)
	}
	_, err = store.PublishSpeech(binding, permit, publication)
	if err != nil || phase == "unexported-final" {
		return err
	}
	state, err := store.Snapshot()
	if err != nil {
		return err
	}
	discussion := DiscussionController{store: store, cfg: Config{ConversationID: conversation}, now: time.Now}
	return discussion.export(state, func(DiscussionOutput) error { return nil })
}

func FixturePersonalPhase(dir, message string) (string, bool, error) {
	store, err := OpenStore(dir)
	if err != nil {
		return "", false, err
	}
	defer store.Close()
	snapshot, err := store.Snapshot()
	if err != nil {
		return "", false, err
	}
	for _, admission := range snapshot.Admissions {
		if admission.Origin != nil && admission.Origin.MessageID == message {
			return admission.Phase, admission.SourceCutover, nil
		}
	}
	return "", false, ErrNotFound
}

// FixtureActivate opens the original manager lane without submitting a prompt.
func (d *DiscussionController) FixtureActivate(ctx context.Context) (ManagerBinding, error) {
	st, err := d.store.Snapshot()
	if err != nil {
		return ManagerBinding{}, err
	}
	if err := d.activate(ctx, st); err != nil {
		return ManagerBinding{}, err
	}
	for {
		status, err := d.controller.nativeStatus(ctx)
		if err != nil {
			return ManagerBinding{}, err
		}
		if status.ReadyForInput && !status.Turn.ExternallySteered {
			return d.controller.binding, d.store.observeController(d.controller.binding, status.Turn.ExternalInput, false)
		}
		select {
		case <-ctx.Done():
			return ManagerBinding{}, ctx.Err()
		case <-time.After(100 * time.Millisecond):
		}
	}
}

// FixtureAdmittedFileWake verifies the original Go publication file authority
// and returns captured bytes without resolving or publishing the native turn.
func FixtureAdmittedFileWake(dir, settings string) ([][]byte, error) {
	store, err := OpenStore(dir)
	if err != nil {
		return nil, err
	}
	defer store.Close()
	st, err := store.Snapshot()
	if err != nil {
		return nil, err
	}
	conversation := st.CurrentConversation
	current := st.Conversations[conversation]
	if !current.Binding.NativeCLI {
		return nil, ErrInvalid
	}
	var result [][]byte
	for _, wake := range st.Wakes {
		if wake.State != "native_input" || wake.ConversationID != conversation {
			continue
		}
		admission := st.Admissions[admissionKey(conversation, wake.Admission)]
		if !admission.SettledAt.IsZero() || admission.RecoveryOnly || admission.NativeBindingRetired ||
			wake.NativeInputID == "" || admission.NativeInputID != wake.NativeInputID || result != nil {
			return nil, ErrStale
		}
		note, binding, err := publicationWorkerNote(st, conversation, wake.Admission)
		if err != nil {
			return nil, err
		}
		worker := st.Workers[key(conversation, key(note.Session, note.Instance))]
		parent := st.Admissions[admissionKey(conversation, worker.Admission)]
		if parent.Origin == nil || parent.Origin.Kind != "owner_direct" || parent.NativeInputID == "" ||
			worker.ParentInputHash != hashBytes([]byte(parent.NativeInputID)) {
			return nil, ErrStale
		}
		result = make([][]byte, 0, len(note.Files))
		for _, file := range note.Files {
			data, err := workermail.ReadFile(settings, binding, note.NoteID, file.ID)
			if err != nil {
				return nil, err
			}
			result = append(result, data)
		}
	}
	if result == nil {
		return nil, ErrNotFound
	}
	return result, nil
}

// FixtureValidateStagedFileWake verifies the ordinary original Go publication.
func FixtureValidateStagedFileWake(dir, settings string) ([][]byte, error) {
	store, err := OpenStore(dir)
	if err != nil {
		return nil, err
	}
	defer store.Close()
	st, err := store.Snapshot()
	if err != nil {
		return nil, err
	}
	d := DiscussionController{store: store, cfg: Config{ConversationID: st.CurrentConversation},
		scope: DiscussionScope{VMProjectAccess: true, ManagerSettingsDir: settings}}
	var output DiscussionOutput
	for _, p := range st.Publications {
		if p.DiscussionFiles == "" {
			continue
		}
		if output.ID != "" {
			return nil, ErrConflict
		}
		output = publicationOutput(p)
	}
	if output.ID == "" {
		return nil, ErrNotFound
	}
	ctx := context.Background()
	hash := schema.PublicationContentHash(output.Text, output.FileMetadata(), output.RecipientID)
	if err := d.ValidatePublication(ctx, output, hash); err != nil {
		return nil, err
	}
	return d.ReadPublicationFiles(ctx, output)
}

// FixtureQueuedFileWitness reads an actual daemon-authenticated worker note before
// the original Go voice scheduler ingests it.
func FixtureQueuedFileWitness(dir, settings, message string) (schema.MessageOrigin, workermail.Note, [][]byte, error) {
	var none schema.MessageOrigin
	db, err := bolt.Open(filepath.Join(dir, "voice.db"), 0, &bolt.Options{
		ReadOnly: true, Timeout: time.Second, OpenFile: openInventoryLedger,
	})
	if err != nil {
		return none, workermail.Note{}, nil, err
	}
	defer db.Close()
	var st State
	if err := db.View(func(tx *bolt.Tx) error {
		var err error
		st, err = readState(tx)
		return err
	}); err != nil {
		return none, workermail.Note{}, nil, err
	}
	conversation := st.CurrentConversation
	binding := st.Conversations[conversation].Binding
	_, manager, found := strings.Cut(binding.SessionID, "/")
	if !binding.NativeCLI || !found || manager == "" {
		return none, workermail.Note{}, nil, ErrStale
	}
	notes, err := workermail.Pending(settings, conversation)
	if err != nil || len(notes) != 1 {
		return none, workermail.Note{}, nil, errors.Join(ErrNotFound, err)
	}
	note := notes[0]
	if note.Kind != "complete" || note.State != "queued" || len(note.Files) != 1 || note.Parent != manager ||
		note.Instance == "" || !strings.HasPrefix(note.Attempt, "vm-child-") || note.ParentInputHash == "" {
		return none, note, nil, ErrStale
	}
	var origin *schema.MessageOrigin
	for _, parent := range st.Admissions {
		if parent.ConversationID == conversation && parent.Origin != nil &&
			parent.Origin.MessageID == message && parent.Origin.Kind == "owner_direct" &&
			parent.SourceCutover && parent.Project == note.Project &&
			parent.NativeInputID != "" && hashBytes([]byte(parent.NativeInputID)) == note.ParentInputHash {
			if origin != nil {
				return none, note, nil, ErrConflict
			}
			origin = parent.Origin
		}
	}
	if origin == nil {
		return none, note, nil, ErrNotFound
	}
	wantEvent := "worker-message-" + hashValue([]string{note.Session, note.Instance, note.Attempt, note.ID})
	if _, exists := st.Events[key(conversation, wantEvent)]; exists {
		return none, note, nil, ErrConflict
	}
	data, err := workermail.ReadFile(settings, note.Binding, note.ID, note.Files[0].ID)
	return *origin, note, [][]byte{data}, err
}

// FixturePreparedQueuedWake reads the original Go scheduler records after a
// Rust-prepared wake. It checks the old prompt builder and immutable file.
// FixtureReplacePreparedOperation changes only a disposable Go wake using the
// original Go transaction and checksum writer.
func FixtureReplacePreparedOperation(dir, conversation, session, instance, attempt, noteID, operation string) error {
	store, err := OpenStore(dir)
	if err != nil {
		return err
	}
	defer store.Close()
	id := "worker-message-" + hashValue([]string{session, instance, attempt, noteID})
	return store.update(func(st *State) error {
		k := key(conversation, id)
		wake, ok := st.Wakes[k]
		if !ok || wake.State != "prepared" || wake.Admission != 0 {
			return ErrStale
		}
		wake.OperationID = operation
		putRecord(st, "wakes", &st.Wakes, k, wake)
		return nil
	})
}

func FixturePreparedQueuedWake(dir, settings, conversation, session, instance, attempt, noteID string, pending bool) (string, [][]byte, error) {
	db, err := bolt.Open(filepath.Join(dir, "voice.db"), 0, &bolt.Options{
		ReadOnly: true, Timeout: time.Second, OpenFile: openInventoryLedger,
	})
	if err != nil {
		return "", nil, err
	}
	defer db.Close()
	var st State
	if err := db.View(func(tx *bolt.Tx) error {
		var err error
		st, err = readState(tx)
		return err
	}); err != nil {
		return "", nil, fmt.Errorf("prepared wake cannot reopen in Go: %w", err)
	}
	id := "worker-message-" + hashValue([]string{session, instance, attempt, noteID})
	event := st.Events[key(conversation, id)]
	wake := st.Wakes[key(conversation, id)]
	worker := st.Workers[key(conversation, key(session, instance))]
	if event.ID != id || !event.WorkerMessage || event.WakeID != id || event.AttemptID != attempt ||
		wake.ID != id || wake.State != "prepared" || wake.Admission != 0 || wake.NativeInputID != "" ||
		!validFixtureSemanticSyntax(wake.OperationID) ||
		!worker.supervisorMailbox() || worker.AttemptID != attempt || worker.SessionInstance != instance ||
		worker.ParentInputHash == "" || worker.Admission == 0 {
		return "", nil, ErrStale
	}
	var source workerNoteMetadata
	if err := json.Unmarshal(event.Metadata, &source); err != nil {
		return "", nil, err
	}
	if source.Kind != "complete" || source.NoteID != noteID || len(source.Files) != 1 {
		return "", nil, ErrStale
	}
	text, err := workerNoteWakeText(true, source, event.Metadata, protocol.MaxSendInputText)
	if err != nil {
		return "", nil, err
	}
	var request struct {
		Text string `json:"text"`
	}
	if err := json.Unmarshal(wake.Request, &request); err != nil {
		return "", nil, err
	}
	if request.Text != text {
		return "", nil, fmt.Errorf("prepared wake prompt differs from Go: %w", ErrCorrupt)
	}
	if hashBytes(wake.Request) != wake.RequestHash {
		return "", nil, fmt.Errorf("prepared wake request digest differs from Go: %w", ErrCorrupt)
	}
	binding := workermail.Binding{Discussion: conversation, Parent: worker.Parent, Session: session, Instance: instance, Attempt: attempt}
	note, err := workermail.Lookup(settings, binding, noteID)
	if err != nil {
		return "", nil, err
	}
	expected := "ingested"
	if pending {
		expected = "queued"
	}
	if note.State != expected || note.ParentInputHash != worker.ParentInputHash {
		return "", nil, ErrStale
	}
	data, err := workermail.ReadFile(settings, binding, noteID, source.Files[0].ID)
	return wake.OperationID, [][]byte{data}, err
}

func validFixtureSemanticSyntax(value string) bool {
	_, ok := protocol.SemanticOperationIssuedAt(value)
	return ok
}

// FixtureNativeParentSettled observes the original Go scheduler after it closes
// the genuine parent turn, without manufacturing an admission receipt.
func (d *DiscussionController) FixtureNativeParentSettled(message string) (bool, error) {
	st, err := d.store.Snapshot()
	if err != nil {
		return false, err
	}
	found := false
	for _, a := range st.Admissions {
		if a.ConversationID != d.cfg.ConversationID {
			continue
		}
		if a.SettledAt.IsZero() {
			return false, nil
		}
		if a.Origin != nil && a.Origin.MessageID == message {
			found = a.SourceCutover && a.Phase == "completed"
		}
	}
	for _, wake := range st.Wakes {
		if wake.ConversationID == d.cfg.ConversationID && wake.State != "settled" {
			return false, nil
		}
	}
	conversation := st.Conversations[d.cfg.ConversationID]
	return found && conversation.RetiredThrough == conversation.LastAdmission, nil
}

func FixtureGuildNativeAdmission(dir, message string) (Admission, error) {
	var out Admission
	db, err := bolt.Open(filepath.Join(dir, "voice.db"), 0, &bolt.Options{
		ReadOnly: true, Timeout: time.Second, OpenFile: openInventoryLedger,
	})
	if err != nil {
		return out, err
	}
	defer db.Close()
	err = db.View(func(tx *bolt.Tx) error {
		st, err := readState(tx)
		if err != nil {
			return err
		}
		for _, row := range st.Admissions {
			if row.ConversationID == st.CurrentConversation && row.Origin != nil && row.Origin.MessageID == message {
				if out.Sequence != 0 {
					return ErrConflict
				}
				out = row
			}
		}
		return nil
	})
	return out, err
}
