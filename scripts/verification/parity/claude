#!/usr/bin/env python3
"""Offline substitute for the Claude executable on the fixture PATH."""
import os
from pathlib import Path
import signal
import struct
import subprocess
import sys
import termios
import time
import tty
import fcntl

effects = Path(sys.argv[0]).parent.parent / "effects"
if "--version" in sys.argv:
    barrier = effects / "form-cold"
    deadline = time.monotonic() + 3
    while barrier.exists() and time.monotonic() < deadline:
        time.sleep(0.01)
    print("2.1.100 (Claude Code)")
    sys.exit(0)

effects.mkdir(exist_ok=True)
(effects / "worker").write_text(f"{os.getpid()}\n")
tty.setraw(0)

def geometry(*_):
    rows, cols, _, _ = struct.unpack("HHHH", fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8))
    (effects / "size").write_text(f"{cols}x{rows}\n")

signal.signal(signal.SIGWINCH, geometry)
geometry()
os.write(1, b"\x1b[2J\x1b[Hfixture ready\r\n")
with (effects / "input").open("ab", buffering=0) as log:
    pending = bytearray()
    while data := os.read(0, 1):
        log.write(data)
        if data in (b"\n", b"\r"):
            if (effects / "board-events").exists() and pending in (
                b"fixture permission", b"fixture review", b"fixture busy",
            ):
                event = {b"fixture permission":"PermissionRequest", b"fixture review":"Stop",
                         b"fixture busy":"UserPromptSubmit"}[bytes(pending)]
                owner = Path(sys.argv[0]).parent / "swarm"
                post = subprocess.run([owner, "hook", event], input=b'{"last_assistant_message":"fixture review"}',
                                      capture_output=True, timeout=3)
                (effects / f"event-{event}").write_text(str(post.returncode))
            elif (effects / "grid").exists() and pending == b"before":
                os.write(1, b"\x1b[?1049h\x1b[?25l\x1b[?1h\x1b[?1002h\x1b[?1006h"
                            b"\x1b[?2004h\x1b[2J\x1b[1;1Hfixture grid"
                            b"\x1b[2;3H\x1b[1;4;38;2;20;130;200m"
                            + "年e\u0301Z".encode() +
                            b"\x1b[0m\x1b[3;5H\x1b[7;48;5;42mstyled\x1b[0m"
                            b"\x1b[4;1Hgrid end\x1b[6;11H")
            else:
                visible = (b"after" if (effects / "grid").exists()
                           and pending == b"\x1b[200~after\x1b[201~" else pending)
                os.write(1, b"fixture received " + visible
                         + (b"\r" if (effects / "extra-cr").exists() else b"")
                         + b"\r\nfixture end")
            pending.clear()
        else:
            pending.extend(data)
        if len(pending) > 4096:
            sys.exit(2)
